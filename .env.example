APP_ENV=dev
# 本地开发用 SQLite，不需要 Docker。装好 PostgreSQL 后改成下面这一行。
DATABASE_URL=sqlite:///./ukcn.dev.db
# DATABASE_URL=postgresql+psycopg://ukcn:ukcn@localhost:5432/ukcn
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_SECRET_KEY=dev-only-change-me-32b-secret-key
JWT_ACCESS_TTL_MINUTES=15

# 发帖、转发、建房间前是否要求先验证手机（默认 true）。
# 注意：目前还没接短信服务商，线上验证码发不出去；接入之前线上必须设为 false，否则没有人能发帖。
# REQUIRE_PHONE_VERIFICATION=false

# 对象存储（S3 协议：Backblaze B2、自建 MinIO、Cloudflare R2、AWS S3）。不填 S3_ENDPOINT 就把图片 / 视频存在本机 data/uploads。
# 上传的图片一律转成 WebP、视频转成 720p MP4 后再存（app/media.py）。
# Backblaze B2：桶设为 Public；在 App Keys 建一个只限这个桶的 key（keyID 填 ACCESS_KEY，applicationKey 填 SECRET_KEY）；
#   桶的 Lifecycle Settings 选「Keep only the last version」，否则删除只是隐藏，文件还在、还在计费，注销账号也删不干净。
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_BUCKET=haiwai-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# 用户浏览器取文件的地址前缀（桶要允许匿名读）；不填则用 S3_ENDPOINT/S3_BUCKET（B2 公开桶可以直接这样访问）。
# 想省 B2 下载流量费，可以用 Cloudflare 代理一个子域名指向 B2，再把这里改成那个域名。
# MEDIA_PUBLIC_URL=https://media.example.com/haiwai-media

# 网站对外的地址，sitemap、canonical、分享卡片里的链接用它。线上前面有 HTTPS 时必须填，不填会生成 http:// 链接。
# docker compose 部署默认已是 https://haiwai.co.uk（见 docker-compose.yml），换域名时才需要改。
# PUBLIC_BASE_URL=https://haiwai.co.uk

# 部署在 nginx / CDN 后面时设为 true：操作日志和登录限流才能拿到真实的客户端 IP（取 X-Forwarded-For 最右边一项）。
# 直接对外提供服务时保持 false，否则客户端可以伪造来源。
# 套 CDN 时：① 源站只放行 CDN 的回源 IP，否则直连源站就能伪造 IP；
#           ② 最好让 CDN 直接回源到 api（中间再隔一层 nginx 的话，nginx 要用 real_ip 模块先还原客户端 IP 再转发）；
#           ③ CDN 上把 /api/* 设为不缓存（接口响应本身也带 Cache-Control: no-store）。
TRUST_PROXY=false
