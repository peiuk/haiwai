APP_ENV=dev
# 本地开发用 SQLite，不需要 Docker。装好 PostgreSQL 后改成下面这一行。
DATABASE_URL=sqlite:///./ukcn.dev.db
# DATABASE_URL=postgresql+psycopg://ukcn:ukcn@localhost:5432/ukcn
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_SECRET_KEY=dev-only-change-me-32b-secret-key
JWT_ACCESS_TTL_MINUTES=15

# 对象存储（S3 协议：自建 MinIO、Cloudflare R2、AWS S3）。不填 S3_ENDPOINT 就把图片 / 视频存在本机 data/uploads。
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=ukcn-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# 用户浏览器取文件的地址前缀（桶要允许匿名读）；不填则用 S3_ENDPOINT/S3_BUCKET
# MEDIA_PUBLIC_URL=https://media.example.com/ukcn-media
